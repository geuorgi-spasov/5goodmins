<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.fivegoodmins</groupId>
	<artifactId>fivegoodmins</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>fivegoodmins</name>
	<description>A directory of small activism actions, with a daily email digest</description>
	<url>https://5goodmins.com</url>
	<licenses>
		<license>
			<name>PolyForm Noncommercial License 1.0.0</name>
			<url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Georgi Spasov</name>
		</developer>
	</developers>
	<scm>
		<url>https://github.com/geuorgi-spasov/5goodmins</url>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Not in Boot's BOM, so the version is ours to own and to bump. -->
		<bucket4j.version>8.21.0</bucket4j.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- JavaMailSender, for the SMTP EmailSender that talks to Mailpit in
		     development (ADR-005). The production transport is a provider's
		     HTTP API and is still open (§5), so this starter is the dev path's
		     dependency rather than the application's mail strategy. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!-- Rate limiting on /login and /register (ADR-002). The core module
		     alone: every other Bucket4j module exists to share buckets across
		     a cluster through Hazelcast, Redis or a JCache provider, and
		     ADR-012 already states this application runs as exactly one
		     instance, which is the same assumption the digest scheduler makes.
		     A distributed bucket store would be the second place that
		     assumption is encoded, and Redis is on the rejected list.

		     NOTE THE ARTIFACT NAME. `bucket4j-core` is a dead line that still
		     looks current: it stops at 8.10.1, and from 8.11 the artifacts are
		     split by the JDK they target. On Java 21 the one to use is
		     `bucket4j_jdk17-core`; `bucket4j_jdk11-core` is a parallel,
		     lower-numbered line, so comparing version numbers across the two
		     is misleading. Caught in review, having first pinned the dead
		     artifact at what looked like its newest release. No transitive
		     dependencies either way. -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j_jdk17-core</artifactId>
			<version>${bucket4j.version}</version>
		</dependency>
		<!-- Bounded storage for those buckets. A plain ConcurrentHashMap keyed
		     on a client address is a memory leak with an attacker's name on
		     it: one entry per address seen, never removed, and an IPv6 /64
		     hands out 2^64 of them. Caffeine gives a maximum size and a
		     time-based eviction in one line each, and its W-TinyLFU policy
		     preferentially keeps the frequently-hit keys, which under an
		     attack are the attacker's. Version managed by Boot's BOM. -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.thymeleaf.extras</groupId>
			<artifactId>thymeleaf-extras-springsecurity6</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- A fixed artifact name, so the Dockerfile names the jar instead of
		     globbing target/*.jar and silently breaking the day a second jar
		     appears there. -->
		<finalName>app</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Applies to spring-boot:run only, not to the repackaged
					     jar, so a local run gets application-dev.yaml while a
					     container starts with no profile and must be given its
					     datasource by the environment. -->
					<profiles>dev</profiles>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
